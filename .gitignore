# ===== Berkas sensitif =====
# Semua varian .env (lokal, localtest, testing, production) sudah dicakup
# aturan ".env.*" di awal file. Folder storage juga sudah self-ignore lewat
# .gitignore bawaan Laravel (storage/**/.gitignore).

# Kunci & sertifikat privat
*.key
*.pem
*.p12
*.pfx
*.ppk
id_rsa
id_ed25519

# Credential / service account
**/auth.json
service-account*.json
credentials*.json
/.aws/

# Arsip & backup — rawan berisi dump DB atau salinan .env
*.zip
*.7z
*.rar
*.tar.gz
*.tgz
*.bak
/backup/

# Patch redesain — artefak kerja, jangan masuk repo
hardware-console-redesign.patch
/docker-compose.yml
# Artefak ekstraksi arsip vendor di Windows. Placeholder "%S%" di dalam path tidak
# pernah di-expand, sehingga terbentuk folder literal berisi salinan pustaka yang
# tidak dibaca Composer (yang dipakai tetap /vendor).
/%S%/
