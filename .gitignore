# ===== Berkas sensitif — jangan pernah masuk repo =====

# Environment: semua varian (.env, .env.local, .env.localtest, .env.production, ...)
# Sudah dicakup ".env.*" di atas, ditulis eksplisit supaya mudah dibaca.
/.env.localtest
/.env.local
/.env.production
/.env.staging
/.env.testing

