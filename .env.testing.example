# Environment untuk test (phpunit). Salin jadi .env.testing lalu isi
# kredensial MySQL lokal Anda. .env.testing TIDAK ikut ter-commit.
#
# phpunit.xml sudah memaksa APP_ENV, DB_CONNECTION, DB_HOST (127.0.0.1),
# DB_PORT (3308), DB_DATABASE (joystickmania_test), CACHE_STORE, SESSION_DRIVER,
# MAIL_MAILER, QUEUE_CONNECTION, dan LOGIN_OTP_ENABLED. Nilai di bawah hanya
# melengkapinya.

APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=joystickmania_test
DB_USERNAME=ganti_dengan_user_mysql_lokal
DB_PASSWORD=ganti_dengan_password_mysql_lokal

MAIL_MAILER=array
