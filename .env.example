APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
PORT_SPLIT_ENABLED=false
USER_PORT=8000
ADMIN_PORT=8001
LOGIN_OTP_ENABLED=false
LOGIN_OTP_EXPIRES_MINUTES=10

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Nomor WhatsApp admin untuk link wa.me (format internasional tanpa "+")
WA_ADMIN_NUMBER=

# ---------------------------------------------------------------------------
# Sentry (error tracking)
# ---------------------------------------------------------------------------
# Kosong = Sentry tidak mengirim apa pun. Ambil DSN dari project Sentry Anda.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=
# Jejak tracing: 0 = mati. Naikkan hanya saat sedang menyelidiki performa,
# karena span tracing juga ikut mengirim URL request ke Sentry.
SENTRY_TRACES_SAMPLE_RATE=0
# Jangan dihidupkan: hosting ini memblokir escapeshellarg, dan breadcrumb
# command_info memanggilnya untuk men-stringifikasi input artisan. Kalau DSN
# terisi sementara flag ini true, seluruh perintah artisan (termasuk
# schedule:run) mati di akhir eksekusi. Alasannya ada di config/sentry.php.
SENTRY_BREADCRUMBS_COMMAND_JOBS_ENABLED=false

# ---------------------------------------------------------------------------
# Notifikasi Telegram (dipakai CrashAlerter / SecurityAlerter / alerts:heartbeat)
# ---------------------------------------------------------------------------
# Buat bot lewat @BotFather untuk token, lalu ambil chat_id Anda lewat
# https://api.telegram.org/bot<TOKEN>/getUpdates setelah mengirim /start ke bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERTING_ENABLED=true
ALERT_THROTTLE_SECONDS=600
ALERT_ON_CRASH=true
ALERT_ON_SECURITY=true
ALERT_ON_BUSINESS=true
ALERT_ON_INFRA=true
ALERT_LOGIN_FAILURE_THRESHOLD=8
ALERT_LOGIN_FAILURE_WINDOW=600
ALERT_DISK_MIN_FREE_PERCENT=10
